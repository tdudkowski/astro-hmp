---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
 
type Props = {
  post: CollectionEntry<'festung_breslau_blog'>
};
 
export async function getStaticPaths() {
  const entries = await getCollection('festung_breslau_blog');
  const today = new Date().toISOString().slice(5,10);
  const allPostsPastMonths = entries.filter((a) => a.id.slice(0,2) < today.slice(0,2))

  const allPostsMonth = entries.filter((a) => a.id.slice(0,2) === today.slice(0,2))
  const allPostsDay = allPostsMonth.filter((a) => a.id.slice(3) <= today.slice(3))

  const totalPosts = allPostsPastMonths.concat(allPostsDay)
  
  return totalPosts.map((entry) => ({
    params: { slug: entry.id },
    props: { post: entry },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
export const prerender = true;
---

<Content post={post} />